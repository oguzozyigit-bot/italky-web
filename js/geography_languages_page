async function ensureTranslationAccess() {
  const tokens = await getTokenBalance();
  if (tokens <= 0) {
    showUiModal("Coğrafyanın Dilleri çevirisi için jeton gerekiyor.");
    return false;
  }
  return true;
}

async function translateNow(text, fromLang, toLang, targetSide) {
  const rawText = normalizeInput(text);
  if (!rawText) return;

  const canRun = await ensureTranslationAccess();
  if (!canRun) return;

  setTranslatingUI(targetSide === "top" ? "bottom" : "top");

  try {
    const res = await fetch(`${API_BASE}/api/translate_ai`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        text: rawText,
        from_lang: canonical(fromLang),
        to_lang: canonical(toLang),
        mode: "cultural",
        cultural: true,
        use_ai: true,
        style: "warm",
        domain: "geography_languages"
      })
    });

    const json = await res.json().catch(() => ({}));
    const translated = String(
      json?.translated ||
      json?.translation ||
      json?.text ||
      ""
    ).trim();

    if (!res.ok || !translated) {
      throw new Error(json?.detail || "Çeviri alınamadı");
    }

    const row = addBubble(targetSide, "me", translated, {
      latest: true,
      speakLang: toLang
    });

    await commitUsage({
      module: "text_ai",
      usageKind: "text",
      charCount: Math.max(rawText.length, translated.length),
      note: buildUsageNote({
        surface: "text",
        usageKind: "text",
        mode: "cultural"
      }),
      meta: {
        surface: "geography_languages",
        from_lang: canonical(fromLang),
        to_lang: canonical(toLang),
        input_chars: rawText.length,
        output_chars: translated.length,
        billable_chars: Math.max(rawText.length, translated.length)
      }
    }).then((usage) => {
      if (typeof usage?.tokens_after === "number") {
        try { setHeaderTokens(usage.tokens_after); } catch {}
      }
    }).catch((e) => {
      if (String(e?.code || "").includes("INSUFFICIENT_TOKENS")) {
        showUiModal("Coğrafyanın Dilleri çevirisi için jeton gerekiyor.");
      }
    });

    const txt = row?.querySelector(".txt");
    if (txt) {
      await speak(txt.textContent, toLang);
    }
  } catch {
    setErrorUI("⚠️ Çeviri servisine ulaşılamadı");
    setTimeout(() => setSystemReadyUI(), 1200);
    return;
  }

  setSystemReadyUI();
}

function buildRecognizer(langCode) {
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  if (!SR) return null;

  const rec = new SR();
  rec.lang = BCP[canonical(langCode)] || "tr-TR";
  rec.interimResults = true;
  rec.continuous = true;
  rec.maxAlternatives = 1;
  return rec;
}

function stopRecognizer() {
  if (recognizer) {
    try { recognizer.stop(); } catch {}
  }
}

function getPreviewText(side) {
  const body = side === "top" ? topBody : botBody;
  const previewNode = body?.querySelector(".bubble.them.preview .txt");
  return String(previewNode?.textContent || "").trim();
}

function buildStableTranscript(results) {
  const pieces = [];

  for (let i = 0; i < results.length; i++) {
    const chunk = String(results[i]?.[0]?.transcript || "").replace(/\s+/g, " ").trim();
    if (!chunk) continue;

    const prev = pieces[pieces.length - 1] || "";
    if (prev === chunk) continue;
    if (prev && chunk.startsWith(prev)) {
      pieces[pieces.length - 1] = chunk;
      continue;
    }
    if (prev && prev.startsWith(chunk)) {
      continue;
    }

    pieces.push(chunk);
  }

  return pieces.join(" ").replace(/\s+/g, " ").trim();
}

function cleanupFinalTranscript(text) {
  return String(text || "")
    .replace(/\s+/g, " ")
    .replace(/\b(\S+)( \1\b)+/gi, "$1")
    .trim();
}

function startRecording(side) {
  const lang = side === "top" ? topLang : botLang;
  const rec = buildRecognizer(lang);

  if (!rec) {
    setErrorUI("⚠️ Bu cihazda konuşma algılama desteklenmiyor");
    setTimeout(() => setSystemReadyUI(), 1500);
    return;
  }

  const mySessionId = ++recognitionSessionId;

  recognizer = rec;
  recordingSide = side;
  liveTranscript = "";
  latestPreviewTranscript = "";

  rec.onstart = () => {
    setListeningUI(side);
  };

  rec.onresult = (e) => {
    if (mySessionId !== recognitionSessionId) return;

    const builtText = buildStableTranscript(e.results);
    if (!builtText) return;

    liveTranscript = builtText;
    latestPreviewTranscript = builtText;

    const body = side === "top" ? topBody : botBody;
    let previewNode = body?.querySelector(".bubble.them.preview");

    if (!previewNode) {
      previewNode = document.createElement("div");
      previewNode.className = "bubble them preview";
      previewNode.innerHTML = `<div class="bubble-row"><span class="txt"></span></div>`;
      body?.appendChild(previewNode);
    }

    const txtEl = previewNode.querySelector(".txt");
    if (txtEl) txtEl.textContent = builtText;

    keepLatestVisible(side);
  };

  rec.onerror = () => {
    if (mySessionId !== recognitionSessionId) return;
    setErrorUI("⚠️ Mikrofon başlatılamadı");
    recognizer = null;
    recordingSide = null;
    setTimeout(() => setSystemReadyUI(), 1200);
  };

  rec.onend = () => {
    if (mySessionId !== recognitionSessionId) return;

    const sideAtEnd = side;
    const previewText = getPreviewText(sideAtEnd);
    const finalText = cleanupFinalTranscript(previewText || latestPreviewTranscript || liveTranscript || "");

    recognizer = null;
    recordingSide = null;
    liveTranscript = "";
    latestPreviewTranscript = "";

    const previewNode = (sideAtEnd === "top" ? topBody : botBody)?.querySelector(".bubble.them.preview");
    previewNode?.remove();

    if (!finalText) {
      setSystemReadyUI();
      return;
    }

    if (sideAtEnd === "top") {
      topText = finalText;
      addBubble("top", "them", finalText);
      translateNow(finalText, topLang, botLang, "bot");
    } else {
      botText = finalText;
      addBubble("bot", "them", finalText);
      translateNow(finalText, botLang, topLang, "top");
    }
  };

  try {
    rec.start();
  } catch {
    recognizer = null;
    recordingSide = null;
    setErrorUI("⚠️ Mikrofon başlatılamadı");
    setTimeout(() => setSystemReadyUI(), 1200);
  }
}

async function toggleRecording(side) {
  if (recordingSide === side) {
    setTranslatingUI(side);
    setTimeout(() => stopRecognizer(), 120);
    return;
  }

  if (recordingSide && recordingSide !== side) {
    setTranslatingUI(recordingSide);
    setTimeout(() => stopRecognizer(), 80);
    return;
  }

  startRecording(side);
}

function bindKeyboardButton(el, handler) {
  if (!el) return;
  el.addEventListener("keydown", async (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      await handler(e);
    }
  });
}

