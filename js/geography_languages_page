  ab: "tr-TR"
};

function canonical(code) {
  return String(code || "").toLowerCase().split("-")[0].trim();
}

function getFullLangPool() {
  try {
    const siteLang = "tr";
    const pool = getLangPoolForSite(siteLang) || [];
    const seen = new Set();
    const out = [];

    for (const item of pool) {
      const code = canonical(item?.code || item?.lang || item?.value || "");
      if (!code || seen.has(code)) continue;
      seen.add(code);
      out.push({
        code,
        flag: item?.flag || "🌐",
        name: item?.name || item?.label || code.toUpperCase(),
        bcp: BCP[code] || "tr-TR"
      });
    }

    return out;
  } catch {
    return [
      { code: "tr", flag: "🇹🇷", name: "Türkçe", bcp: "tr-TR" },
      { code: "en", flag: "🇬🇧", name: "English", bcp: "en-US" },
      { code: "de", flag: "🇩🇪", name: "Deutsch", bcp: "de-DE" },
      { code: "fr", flag: "🇫🇷", name: "Français", bcp: "fr-FR" },
      { code: "es", flag: "🇪🇸", name: "Español", bcp: "es-ES" },
      { code: "it", flag: "🇮🇹", name: "Italiano", bcp: "it-IT" }
    ];
  }
}

function buildGeoPool(fullPool) {
  const byCode = new Map(fullPool.map((x) => [x.code, x]));
  const out = [];

  for (const code of GEO_CODES) {
    if (byCode.has(code)) out.push(byCode.get(code));
  }

  for (const item of GEO_FALLBACK) {
    if (!out.find((x) => x.code === item.code)) {
      out.push({
        ...item,
        bcp: BCP[item.code] || "tr-TR"
      });
    }
  }

  return out;
}

function langObj(code, list) {
  const c = canonical(code);
  return (list || []).find((x) => x.code === c) || {
    code: c,
    flag: "🌐",
    name: c.toUpperCase(),
    bcp: BCP[c] || "tr-TR"
  };
}

function labelChip(list, code) {
  const o = langObj(code, list);
  return `${o.flag} ${o.name}`;
}

function closeAllPop() {
  popTop?.classList.remove("show");
  popBot?.classList.remove("show");
}

function renderPop(side) {
  const list = side === "top" ? listTop : listBot;
  const pool = side === "top" ? TOP_LANGS : BOT_LANGS;
  const selected = side === "top" ? topLang : botLang;
  if (!list) return;

  list.innerHTML = pool.map((l) => `
    <div class="pop-item ${canonical(l.code) === canonical(selected) ? "active" : ""}" data-code="${l.code}">
      <div class="pop-left">
        <div class="pop-flag">${l.flag}</div>
        <div class="pop-name">${l.name}</div>
      </div>
      <div class="pop-code">${l.code.toUpperCase()}</div>
    </div>
  `).join("");

  list.querySelectorAll(".pop-item").forEach((el) => {
    el.addEventListener("click", () => {
      const code = canonical(el.dataset.code || "");
      if (!code) return;

      if (side === "top") {
        topLang = code;
        topLangTxt.textContent = labelChip(TOP_LANGS, topLang);
      } else {
        botLang = code;
        botLangTxt.textContent = labelChip(BOT_LANGS, botLang);
      }

      closeAllPop();
      setSystemReadyUI();
    });
  });
}

function pointOrbTo(side) {
  frameRoot.classList.remove("to-top", "to-bot");
  frameRoot.classList.add(side === "top" ? "to-top" : "to-bot");
}

function setMicState(side, state) {
  const mic = side === "top" ? topMic : botMic;
  mic?.classList.remove("listening", "recorded");
  if (state === "listening") mic?.classList.add("listening");
  if (state === "recorded") mic?.classList.add("recorded");
}

function resetMics() {
  topMic?.classList.remove("listening", "recorded");
  botMic?.classList.remove("listening", "recorded");
}

function setFrameVisual(state) {
  frameRoot.classList.remove("is-idle", "is-listening", "is-translating", "is-ready", "is-error");
  if (state) frameRoot.classList.add(`is-${state}`);
}

function setHelper(el, text, cls) {
  if (!el) return;
  el.className = "helper-text";
  if (cls) el.classList.add(cls);
  el.textContent = text || "";
}

