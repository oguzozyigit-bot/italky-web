{
  "rewrites": [
    {
      "source": "/hosgeldiniz",
      "destination": "/pages/hosgeldiniz.html"
    },
    {
      "source": "/a/:token",
      "destination": "/pages/activation_link.html"
    },
    {
      "source": "/kampanya",
      "destination": "/pages/code_load.html"
    }
  ],
  "headers": [
    {
      "source": "/js/center_swipe_return.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/js/supabase_client.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    },
    {
      "source": "/js/icany_bridge.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/hosgeldiniz",
      "statusCode": 308
    },
    {
      "source": "/index.html",
      "destination": "/hosgeldiniz",
      "statusCode": 308
    },
    {
      "source": "/home.html",
      "destination": "/pages/home.html?hub=1",
      "statusCode": 302
    },
    {
      "source": "/indir",
      "destination": "https://play.google.com/store/apps/details?id=com.ozyigits.italkyai",
      "statusCode": 302
    }
  ]
}
