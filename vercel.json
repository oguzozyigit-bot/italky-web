{
  "routes": [
    {
      "src": "^/\\.well-known/(.*)",
      "dest": "/.well-known/$1"
    },

    {
      "src": "^/open/interpreter$",
      "dest": "/pages/open_interpreter.html"
    },

    {
      "src": "^/pages/(.*)",
      "dest": "/pages/$1"
    },

    {
      "src": "^/js/(.*)",
      "dest": "/js/$1"
    },

    {
      "src": "^/css/(.*)",
      "dest": "/css/$1"
    },

    {
      "src": "^/assets/(.*)",
      "dest": "/assets/$1"
    }
  ]
}
